//ZMG01RS  JOB (BREXX),'ZMG0001',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0001 (BREXX/370 TSO INTEGRATION) - REMOVE
//*
//* STEP SMP: RESTORE TAKES ZMG0001 OUT OF THE INVENTORY AND RELINKS
//* EXEC FROM THE DISTRIBUTION LIBRARY SYS1.AOST4.  EXEC IS THEN AT THE
//* LEVEL OF IKJCT430 IN THE DLIB (UY16532) AND BEHAVES AS BEFORE.  THE
//* CSECT IKJCT437 STAYS IN THE LOAD MODULE, BUT NOTHING REFERENCES IT.
//* RESTORE WORKS ONLY WHEN PTF UY16532 IS ACCEPTED (ZMG01CK SHOWS
//* "ACC"): OTHERWISE IT ENDS WITH HMA3022 "MISSING/NOGO REQUISITES:
//* UY16532 PRE".  ACCEPTING A PTF UPDATES SYS1.AOST4 AND IS YOUR
//* DECISION; BACK IT UP FIRST.
//*
//* STEP COPY IS OPTIONAL.  IT PUTS THE EXEC FROM BEFORE THE APPLY BACK
//* (ZMG01BK), WHICH MAKES EXEC BYTE-IDENTICAL TO THE LEVEL BEFORE THE
//* INSTALLATION, WITHOUT IKJCT437.  TO DROP THE STEP, DELETE THE
//* STATEMENTS FROM //COPY ON AND KEEP THE FINAL // LINE.
//* CHANGE: YOUR.ZMG0001.BACKUP.  COMPARE THE EXTENTS OF SYS1.CMDLIB
//* BEFORE AND AFTER, AS FOR THE APPLY.
//*
//* ON TK5, "//SMP EXEC SMPACC" WORKS TOO, WITHOUT THE TWO DD CARDS
//* AOST4 AND CMDLIB: SMPACC (SYS1.PROCLIB) HAS ALL DLIBS AND TARGET
//* LIBRARIES.  THE SMPAPP OF TK5 UPDATE 5 HAS NO AOST4, SO THIS JOB
//* KEEPS SMPAPP WITH BOTH DD CARDS, WHICH RUNS ON TK5 AND ON MVS/CE.
//*
//SMP      EXEC SMPAPP
//HMASMP.CMDLIB   DD DSN=SYS1.CMDLIB,DISP=SHR
//HMASMP.AOST4    DD DSN=SYS1.AOST4,DISP=SHR
//HMASMP.SMPCNTL  DD *
 RESTORE SELECT(ZMG0001) .
/*
//COPY     EXEC PGM=IEBCOPY,REGION=4096K,COND=(4,LT,SMP.HMASMP)
//SYSPRINT DD SYSOUT=*
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//IN       DD DSN=YOUR.ZMG0001.BACKUP,DISP=SHR
//OUT      DD DSN=SYS1.CMDLIB,DISP=SHR
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
  SELECT MEMBER=((EXEC,,R),(EX,,R))
/*
//
