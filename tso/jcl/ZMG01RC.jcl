//ZMG01RC  JOB (BREXX),'ZMG0001',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0001 (BREXX/370 TSO INTEGRATION) - RECEIVE AND APPLY CHECK
//*
//* UPLOAD ZMG0001.SMP IN BINARY TO A SEQUENTIAL DATA SET WITH
//* RECFM=FB,LRECL=80 FIRST.  CHANGE: YOUR.ZMG0001.SMP.
//* THE APPLY CHECK CHANGES NOTHING.  ITS LISTING MUST SHOW IKJCT430
//* AND IKJCT437 AS "APPLIED" - NOT "NOT SEL" - BEFORE YOU RUN ZMG01AP.
//*
//SMP      EXEC SMPAPP
//HMASMP.CMDLIB   DD DSN=SYS1.CMDLIB,DISP=SHR
//HMASMP.AOST4    DD DSN=SYS1.AOST4,DISP=SHR
//HMASMP.SMPPTFIN DD DSN=YOUR.ZMG0001.SMP,DISP=SHR
//HMASMP.SMPCNTL  DD *
 RECEIVE SELECT(ZMG0001) .
 APPLY SELECT(ZMG0001) CHECK .
/*
//
