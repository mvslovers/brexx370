//ZMG01CK  JOB (BREXX),'ZMG0001',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0001 (BREXX/370 TSO INTEGRATION) - BEFORE YOU INSTALL
//*
//* LISTS PTF UY16532, WHICH ZMG0001 REQUIRES; ZMG0002 (REKX/370 TSO
//* INTEGRATION), WHICH CHANGES THE SAME EXEC AND EXCLUDES ZMG0001;
//* AND ZMG0003 (IKJCT441 FOR REXX: ISPF VARIABLES FROM AN EXEC),
//* WHICH DOES NOT CHANGE EXEC.  READ THE LISTING, NOT THE RETURN CODE:
//*   UY16532 MUST SHOW STATUS APP (APPLIED).  FOR A LATER REMOVAL OF
//*     ZMG0001 IT MUST ALSO BE ACC (ACCEPTED), SEE ZMG01RS.
//*   ZMG0002 MUST NOT BE THERE.  A NAME UNDER "NOT FOUND" IS NOT
//*     INSTALLED.
//*   ZMG0003 MAY BE THERE OR NOT; IT IS LISTED FOR INFORMATION ONLY.
//*     (THE ZMG01CK OF RELEASE 3.0.0 SAID IT MUST NOT BE THERE; THAT
//*     WAS A DIFFERENT, NEVER BUILT USERMOD OF THE SAME NUMBER.)
//*
//LIST     EXEC SMPAPP
//SMPCNTL  DD  *
 LIST CDS SYSMOD(UY16532,ZMG0001,ZMG0002,ZMG0003) .
 LIST ACDS SYSMOD(UY16532,ZMG0001,ZMG0002,ZMG0003) .
/*
//
