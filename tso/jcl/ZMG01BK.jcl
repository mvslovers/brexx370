//ZMG01BK  JOB (BREXX),'ZMG0001',CLASS=A,
//         MSGCLASS=H,MSGLEVEL=(1,1)
//*
//* ZMG0001 (BREXX/370 TSO INTEGRATION) - BACK UP EXEC BEFORE APPLY
//*
//* COPIES SYS1.CMDLIB(EXEC,EX) INTO A NEW LIBRARY.  KEEP IT: IT IS THE
//* LEVEL TO GO BACK TO WHEN ZMG0001 IS REMOVED (ZMG01RS).
//* CHANGE: YOUR.ZMG0001.BACKUP (TWICE, HERE AND IN ZMG01RS).
//*
//COPY     EXEC PGM=IEBCOPY,REGION=4096K
//SYSPRINT DD SYSOUT=*
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//IN       DD DSN=SYS1.CMDLIB,DISP=SHR
//OUT      DD DSN=YOUR.ZMG0001.BACKUP,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5,5)),
//            DCB=(RECFM=U,BLKSIZE=19069,DSORG=PO)
//SYSIN    DD *
  COPY INDD=IN,OUTDD=OUT
  SELECT MEMBER=(EXEC,EX)
/*
//
